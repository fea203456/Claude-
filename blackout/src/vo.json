[
[[0,1,2,3],"Если в твоём городе погас свет — ты живёшь в самом умном доме."],
[[4],"Двадцать четыре этажа."],
[[5],"Замок без ключа."],
[[6],"Всё — с телефона."],
[[7,8],"Но у него есть одна слабость."],
[[9],"Розетка."],
[[10],"Двадцать первый этаж."],
[[11],"Марк ждёт сына."],
[[12],"Тиму девять."],
[[13],"Он уже в лифте."],
[[14],"Лифт идёт наверх."],
[[15],"Гаснет свет."],
[[16],"Весь город."],
[[17],"Лифт встал."],
[[18],"Между четырнадцатым и пятнадцатым."],
[[20,21],"Правило первое. Береги заряд."],
[[22,23],"Экран и фонарик едят его первыми."],
[[24],"Правило второе."],
[[25],"Насосы встали."],
[[26,27],"Вода уходит с верхних этажей."],
[[28],"Правило третье."],
[[29],"Лифт — не выход."],
[[30],"Только лестница."],
[[31],"Марк звонит."],
[[32],"Гудки."],
[[33],"Вызов прерван."],
[[34],"Сети нет."],
[[35,36],"Вышки тоже на розетке."],
[[37,38],"В кабине — аварийный свет."],
[[39],"На час."],
[[40,41],"Умный дом — оглох."],
[[43,44],"Марк идёт вниз. Пешком."],
[[45],"Рука — на замок."],
[[46],"Замок молчит."],
[[47,48],"Он тоже на розетке."],
[[49],"Дверь не открыть."],
[[50],"Стук."],
[[51],"За дверью — соседка."],
[[52],"Ключ есть?"],
[[53],"Есть. Механический."],
[[54],"Он в машине."],
[[55],"Минус второй этаж."],
[[56],"Заряд — три процента."],
[[57],"Марк заперт."],
[[58],"Тим ждёт."]
]
