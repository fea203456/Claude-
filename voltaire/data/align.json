[
 {
  "id": "p01",
  "text": "Философ нашёл ошибку в расчётах министра —",
  "start": 0.17,
  "end": 2.95
 },
 {
  "id": "p02",
  "text": "и легально обчистил казну Франции.",
  "start": 3.13,
  "end": 5.33
 },
 {
  "id": "p03",
  "text": "Париж.",
  "start": 5.93,
  "end": 6.33
 },
 {
  "id": "p04",
  "text": "Тысяча семьсот двадцать девятый.",
  "start": 6.66,
  "end": 8.1
 },
 {
  "id": "p05",
  "text": "Франция в долгах — по самый парик.",
  "start": 8.31,
  "end": 11.02
 },
 {
  "id": "p06",
  "text": "Министр финансов придумывает гениальный план:",
  "start": 11.48,
  "end": 13.65
 },
 {
  "id": "p07",
  "text": "лотерею для владельцев облигаций.",
  "start": 13.99,
  "end": 15.95
 },
 {
  "id": "p08",
  "text": "Купи билет — казна, может, вернёт долг.",
  "start": 16.26,
  "end": 18.37
 },
 {
  "id": "p09",
  "text": "С бонусом.",
  "start": 18.69,
  "end": 19.25
 },
 {
  "id": "p10",
  "text": "Загвоздка: билет стоил тысячную долю облигации.",
  "start": 19.87,
  "end": 23.07
 },
 {
  "id": "p11",
  "text": "А приз — одинаковый для всех.",
  "start": 23.48,
  "end": 24.98
 },
 {
  "id": "p12",
  "text": "Друг Вольтера, математик Ла Кондамин, посчитал:",
  "start": 25.68,
  "end": 28.34
 },
 {
  "id": "p13",
  "text": "скупи все билеты на самые дешёвые облигации —",
  "start": 28.62,
  "end": 31.36
 },
 {
  "id": "p14",
  "text": "и приз больше, чем ты потратил.",
  "start": 31.69,
  "end": 33.51
 },
 {
  "id": "p15",
  "text": "Ошибка в формуле...",
  "start": 34.26,
  "end": 35.66
 },
 {
  "id": "p16",
  "text": "Беспроигрышная лотерея.",
  "start": 36.15,
  "end": 37.71
 },
 {
  "id": "p17",
  "text": "Вольтер собирает команду: банкиры, нотариусы, пачки облигаций.",
  "start": 38.18,
  "end": 42.62
 },
 {
  "id": "p18",
  "text": "Каждый месяц — выигрыш.",
  "start": 43.28,
  "end": 44.81
 },
 {
  "id": "p19",
  "text": "Каждый.",
  "start": 45.18,
  "end": 45.6
 },
 {
  "id": "p20",
  "text": "Месяц.",
  "start": 45.84,
  "end": 46.47
 },
 {
  "id": "p21",
  "text": "На билетах — девиз:",
  "start": 46.93,
  "end": 48.11
 },
 {
  "id": "p22",
  "text": "«Да здравствует господин министр!»",
  "start": 48.4,
  "end": 50.18
 },
 {
  "id": "p23",
  "text": "Министр в ярости — тащит философа в суд.",
  "start": 50.88,
  "end": 53.4
 },
 {
  "id": "p24",
  "text": "Судья листает законы...",
  "start": 54.06,
  "end": 55.52
 },
 {
  "id": "p25",
  "text": "и разводит руками:",
  "start": 56.43,
  "end": 56.84
 },
 {
  "id": "p26",
  "text": "всё... законно.",
  "start": 57.72,
  "end": 58.71
 },
 {
  "id": "p27",
  "text": "Министра вскоре сняли.",
  "start": 59.31,
  "end": 61.0
 },
 {
  "id": "p28",
  "text": "А Вольтер стал миллионером —",
  "start": 61.86,
  "end": 63.17
 },
 {
  "id": "p29",
  "text": "и больше ни дня не работал ради денег.",
  "start": 63.3,
  "end": 67.22
 },
 {
  "id": "p30",
  "text": "Только писал.",
  "start": 67.86,
  "end": 68.39
 },
 {
  "id": "p31",
  "text": "Дерзко, свободно — десятки томов.",
  "start": 68.86,
  "end": 71.08
 },
 {
  "id": "p32",
  "text": "Все его книги оплатила одна чужая ошибка.",
  "start": 71.5,
  "end": 74.72
 },
 {
  "id": "p33",
  "text": "Потому что однажды...",
  "start": 75.41,
  "end": 76.38
 }
]